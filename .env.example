HTTP_ADDR=127.0.0.1:8080
API_PROXY_TARGET=http://127.0.0.1:8080
# Set to the browser-facing HTTPS origin behind a reverse proxy; no trailing slash.
PUBLIC_ORIGIN=

DATABASE_PATH=data/calculator.sqlite
STATISTICS_ENABLED=true
ACHIEVEMENTS_ENABLED=true
ROOMS_ENABLED=false
ROOM_CODE=demo
ROOM_PUBLICATION_ENABLED=true
ROOM_REACTIONS_ENABLED=true
ROOM_EFFECTS_ENABLED=true
# Empty uses the web directory beside the built calculator executable.
WEB_ASSETS_DIR=
